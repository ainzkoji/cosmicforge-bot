# Production environment for the trading backend on a server.
#
# Target file:  /opt/cosmicforge/cosmicforge-bot/backends/bot-backend/.env
# Permissions:  chown cosmicforge:cosmicforge .env && chmod 600 .env
#
# THIS FILE HOLDS NO SECRETS AND IS NOT A COMPLETE .env. The reliable way to
# build the server's .env is:
#
#   1. copy the .env of the runtime you are migrating FROM (it already passes
#      the production-profile validation and decrypts the stored credentials);
#   2. change only the keys in section A below;
#   3. confirm sections B and C still hold.
#
# backends/bot-backend/.env.example documents every other key.
# The process refuses to start if the production profile below is violated
# (PRODUCTION_PROFILE_CONFLICT lists each offending key).

# ── A. Server-specific: change these when moving to the VPS ─────────────────

# Absolute path (four slashes) on local disk that survives reboots. Never a
# network filesystem (NFS, SMB, object-store mounts): SQLite locking is not
# safe there. The directory must be writable by the service user.
DATABASE_URL=sqlite:////var/lib/cosmicforge/cosmicforge.db

# Make every commit durable before it returns. The order intent written just
# before a broker CREATE then survives a host power loss or kernel crash, not
# only a process crash. (NORMAL is the default; OFF is never accepted.)
SQLITE_SYNCHRONOUS=FULL

# ── B. Production profile: required values, validated at startup ────────────

APP_ENV=PRODUCTION
RUNTIME_ENV=PRODUCTION
API_ENV=PRODUCTION
UI_ENV=PRODUCTION
ENVIRONMENT_NAME=production
DATABASE_ROLE=production
EXECUTION_MODE=live
CATI_MODE=LIVE
CATI_SOLE_ENGINE=true
TRADING_ENABLED=true
MARKET_DATA_MODE=LIVE
BROKER_ENVIRONMENT=ACCOUNT_SCOPED
STRATEGY_NAME=RESIDUAL_MOMENTUM_PORTFOLIO_TOP1

BINANCE_ENV=mainnet
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BYBIT_ENV=mainnet
BYBIT_BASE_URL=https://api.bybit.com
BINGX_ENV=mainnet
BINGX_BASE_URL=https://open-api.bingx.com

BROKER_DISCOVERY_ENABLED=true
BALANCE_SYNC_ENABLED=true
POSITION_SYNC_ENABLED=true
ORDER_SYNC_ENABLED=true
RECONCILIATION_ENABLED=true
RISK_ENGINE_ENABLED=true
FX_PIPELINE_ENABLED=true
FORWARD_OBSERVATION_ENABLED=true

LEGACY_V2_ENABLED=false
FALLBACK_ENGINE_ENABLED=false
PAPER_TRADING_MODE=false
ML_ENABLED=false
TRADINGVIEW_EXTERNAL_SIGNALS_ENABLED=false
TRADINGVIEW_ALLOW_PAPER_LIVE_MODE=false
TRADINGVIEW_TESTNET_ONLY=false
EVENT_FILTER_STALE_FAILSAFE_TESTNET_WARN_ONLY=false

# ── C. Order gates: which broker environments may receive orders ────────────
# These two switches are independent. The environment of each connected broker
# account (DEMO or LIVE) is a property of the account, not of this file.

# Binance DEMO account execution: on.
DEMO_ORDER_SUBMISSION_ENABLED=true
# Real-money order submission: OFF. Do not change this as part of a deployment.
LIVE_ORDER_SUBMISSION_ENABLED=false

# ── D. Secrets: set on the server, never commit, never paste into a ticket ──

# Decrypts the broker credentials stored in the database. It MUST be the exact
# value used on the machine that encrypted them: copy it from that machine's
# .env. A missing key stops the process at startup; a wrong key leaves the
# account unreadable and blocked (it never trades on a guess).
BROKER_SECRET_KEY=

# Signs API sessions, and authenticates the user-backend to this engine. Both
# have insecure built-in defaults: set long random values before the API is
# reachable from outside the server, and set the SAME values in the
# user-backend. (openssl rand -hex 32)
# SECRET_KEY is REQUIRED: the process refuses to start in production while it
# is empty (as below), a default/placeholder, or shorter than 32 characters.
# There is deliberately no usable value here. Generate one on the server with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# and give the user-backend and admin-backend the SAME value. The user-backend
# additionally requires its own, different CREDENTIAL_KEY (it encrypts 2FA
# secrets) and SMTP_HOST / SMTP_USER / SMTP_PASSWORD (it emails the
# verification and password-reset codes).
SECRET_KEY=
ENGINE_API_KEY=

# KYC (user-backend). REQUIRED in production: without real values every /kyc
# endpoint answers 503. Generate each with `openssl rand -hex 32`.
# KYC_ENCRYPTION_KEY encrypts KYC personal data and identity documents at rest.
# Keep it stable and backed up: changing or losing it makes stored KYC data
# unreadable. KYC_URL_SECRET signs the short-lived document upload URLs.
KYC_ENCRYPTION_KEY=
KYC_URL_SECRET=
# Optional: private directory for the encrypted KYC documents (default:
# backends/user-backend/data/kyc_uploads). Keep it outside any git checkout
# and include it in backups.
# KYC_UPLOAD_DIR=

# Telegram webhook authentication (user-backend). REQUIRED in production if
# the Telegram webhook is used: updates whose X-Telegram-Bot-Api-Secret-Token
# header does not match are rejected. Register the webhook with the SAME value:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d url=https://<api-host>/api/notifications/telegram/webhook -d secret_token=<value>
# (1-256 characters, only A-Z a-z 0-9 _ and -)
TELEGRAM_WEBHOOK_SECRET=

# ── E. Runtime supervisor (defaults shown; normally leave unset) ────────────
# Do not disable it under the provided systemd unit: the unit waits for the
# supervisor's readiness and keep-alive notifications (Type=notify, WatchdogSec).
# RUNTIME_SUPERVISOR_ENABLED=true
# RUNTIME_SUPERVISOR_INTERVAL_SECONDS=15
# RUNTIME_SUPERVISOR_STARTUP_GRACE_SECONDS=180
# RUNTIME_SUPERVISOR_CONFIRMATIONS=4
# RUNTIME_SUPERVISOR_SLOW_CONFIRMATIONS=20
# RUNTIME_SUPERVISOR_LEASE_STALE_SECONDS=150
# RUNTIME_SUPERVISOR_CYCLE_STALL_SECONDS=600
# RUNTIME_SUPERVISOR_COLLECTOR_STALL_SECONDS=3600
# RUNTIME_SUPERVISOR_DECISION_STALL_SECONDS=9000

# ── F. API surface hardening (bot-backend; defaults shown) ──────────────────
# Addresses a user supplies for their own broker gateway (IBKR TWS / IB Gateway
# host:port, IBKR gateway URL, MT4/MT5 bridge URL) are checked before the
# engine connects to them. In production, loopback and private addresses are
# REFUSED unless listed here: comma-separated host or host:port. If an IBKR
# gateway runs on this server, list it, e.g. 127.0.0.1:4001,127.0.0.1:7496.
# Link-local / cloud-metadata addresses (169.254.0.0/16) can never be listed.
# BROKER_GATEWAY_ALLOWED_HOSTS=
# TLS verification for those gateway / bridge URLs: auto (verify in production),
# true (always verify), false (legacy: self-signed gateways are not verified).
# BROKER_GATEWAY_VERIFY_TLS=auto
# /docs, /redoc and /openapi.json are not served in production unless enabled.
# API_DOCS_ENABLED=false

# ── G. Billing / Stripe (set in backends/user-backend/.env, not here) ───────
# The user-backend serves billing and reads its own .env. Until these are set,
# checkout answers 503 "Billing is not configured" and the webhook rejects
# every request; there is no mock payment provider in production.
# STRIPE_SECRET_KEY=            # live secret key (sk_live_... or rk_live_...)
# STRIPE_WEBHOOK_SECRET=        # whsec_... of the endpoint <api-origin>/api/billing/webhook
# STRIPE_PRICE_PRO_MONTHLY=     # price_... recurring monthly, Nebula Voyager
# STRIPE_PRICE_PRO_YEARLY=      # price_... recurring yearly,  Nebula Voyager
# STRIPE_PRICE_WHALE_MONTHLY=   # price_... recurring monthly, Galactic Tycoon
# STRIPE_PRICE_WHALE_YEARLY=    # price_... recurring yearly,  Galactic Tycoon
# FRONTEND_URL=                 # public https origin of the user frontend (checkout return URLs)
# Test-mode keys and test-mode webhook events are refused in production.
# BILLING_ALLOW_STRIPE_TEST_MODE=false
