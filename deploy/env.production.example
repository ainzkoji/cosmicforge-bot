# Production environment for the trading backend on a server.
#
# Target file:  /opt/cosmicforge/cosmicforge-bot/backends/bot-backend/.env
# Permissions:  chown cosmicforge:cosmicforge .env && chmod 600 .env
#
# THIS FILE HOLDS NO SECRETS AND IS NOT A COMPLETE .env. The reliable way to
# build the server's .env is:
#
#   1. copy the .env of the runtime you are migrating FROM (it already passes
#      the production-profile validation and decrypts the stored credentials);
#   2. change only the keys in section A below;
#   3. confirm sections B and C still hold.
#
# backends/bot-backend/.env.example documents every other key.
# The process refuses to start if the production profile below is violated
# (PRODUCTION_PROFILE_CONFLICT lists each offending key).

# ── A. Server-specific: change these when moving to the VPS ─────────────────

# Absolute path (four slashes) on local disk that survives reboots. Never a
# network filesystem (NFS, SMB, object-store mounts): SQLite locking is not
# safe there. The directory must be writable by the service user.
DATABASE_URL=sqlite:////var/lib/cosmicforge/cosmicforge.db

# Make every commit durable before it returns. The order intent written just
# before a broker CREATE then survives a host power loss or kernel crash, not
# only a process crash. (NORMAL is the default; OFF is never accepted.)
SQLITE_SYNCHRONOUS=FULL

# ── B. Production profile: required values, validated at startup ────────────

APP_ENV=PRODUCTION
RUNTIME_ENV=PRODUCTION
API_ENV=PRODUCTION
UI_ENV=PRODUCTION
ENVIRONMENT_NAME=production
DATABASE_ROLE=production
EXECUTION_MODE=live
CATI_MODE=LIVE
CATI_SOLE_ENGINE=true
TRADING_ENABLED=true
MARKET_DATA_MODE=LIVE
BROKER_ENVIRONMENT=ACCOUNT_SCOPED
STRATEGY_NAME=RESIDUAL_MOMENTUM_PORTFOLIO_TOP1

BINANCE_ENV=mainnet
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BYBIT_ENV=mainnet
BYBIT_BASE_URL=https://api.bybit.com
BINGX_ENV=mainnet
BINGX_BASE_URL=https://open-api.bingx.com

BROKER_DISCOVERY_ENABLED=true
BALANCE_SYNC_ENABLED=true
POSITION_SYNC_ENABLED=true
ORDER_SYNC_ENABLED=true
RECONCILIATION_ENABLED=true
RISK_ENGINE_ENABLED=true
FX_PIPELINE_ENABLED=true
FORWARD_OBSERVATION_ENABLED=true

LEGACY_V2_ENABLED=false
FALLBACK_ENGINE_ENABLED=false
PAPER_TRADING_MODE=false
ML_ENABLED=false
TRADINGVIEW_EXTERNAL_SIGNALS_ENABLED=false
TRADINGVIEW_ALLOW_PAPER_LIVE_MODE=false
TRADINGVIEW_TESTNET_ONLY=false
EVENT_FILTER_STALE_FAILSAFE_TESTNET_WARN_ONLY=false

# ── C. Order gates: which broker environments may receive orders ────────────
# These two switches are independent. The environment of each connected broker
# account (DEMO or LIVE) is a property of the account, not of this file.

# Binance DEMO account execution: on.
DEMO_ORDER_SUBMISSION_ENABLED=true
# Real-money order submission: OFF. Do not change this as part of a deployment.
LIVE_ORDER_SUBMISSION_ENABLED=false

# ── D. Secrets: set on the server, never commit, never paste into a ticket ──

# Decrypts the broker credentials stored in the database. It MUST be the exact
# value used on the machine that encrypted them: copy it from that machine's
# .env. A missing key stops the process at startup; a wrong key leaves the
# account unreadable and blocked (it never trades on a guess).
BROKER_SECRET_KEY=

# Signs API sessions, and authenticates the user-backend to this engine. Both
# have insecure built-in defaults: set long random values before the API is
# reachable from outside the server, and set the SAME values in the
# user-backend. (openssl rand -hex 32)
SECRET_KEY=
ENGINE_API_KEY=

# ── E. Runtime supervisor (defaults shown; normally leave unset) ────────────
# RUNTIME_SUPERVISOR_ENABLED=true
# RUNTIME_SUPERVISOR_INTERVAL_SECONDS=15
# RUNTIME_SUPERVISOR_STARTUP_GRACE_SECONDS=180
# RUNTIME_SUPERVISOR_CONFIRMATIONS=4
# RUNTIME_SUPERVISOR_SLOW_CONFIRMATIONS=20
# RUNTIME_SUPERVISOR_LEASE_STALE_SECONDS=150
# RUNTIME_SUPERVISOR_CYCLE_STALL_SECONDS=600
# RUNTIME_SUPERVISOR_COLLECTOR_STALL_SECONDS=3600
# RUNTIME_SUPERVISOR_DECISION_STALL_SECONDS=9000
