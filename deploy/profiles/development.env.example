# CosmicForge configuration profile: Development (a developer machine)
#
# A TEMPLATE WITH NO SECRETS. Validate it (and any copy you make) with
#   python scripts/validate_config_profile.py deploy/profiles/development.env.example
# Rules: backends/shared/shared_lib/core/config_profiles.py. Format: plain KEY=value lines (systemd EnvironmentFile
# and compose env_file read the same format); a comment only on its own line.
# Secrets never appear here: they are delivered by file (PROFILE_SECRETS_ENV_FILE, PGPASSFILE). PROFILE_* keys are
# read by the process manager / deployer, not by the application (which ignores unknown keys).
# Purpose: local development. SQLite or PostgreSQL, DEMO endpoints, no orders of any kind.

CONFIG_PROFILE=development

# -- Runtime --
APP_ENV=DEVELOPMENT
ENVIRONMENT_NAME=development
DATABASE_ROLE=development
EXECUTION_MODE=paper
PROCESS_ROLE=all
DATABASE_URL=sqlite:///./data/development.db

# -- Exchange environment: DEMO endpoints only --
BINANCE_ENV=demo
BINANCE_FAPI_BASE_URL=https://demo-fapi.binance.com
BYBIT_ENV=demo
BYBIT_BASE_URL=https://api-demo.bybit.com
BINGX_ENV=demo
BINGX_BASE_URL=https://open-api-vst.bingx.com

# -- Request budget: the shared admission scope and the universe share of the venue weight. The per-venue weights
# and the user-stream (WebSocket) limits are code constants (shared_lib.broker.rate_budget, user_stream.py). --
CATI_EGRESS_SCOPE=development-local
UNIVERSE_REQUEST_WEIGHT_BUDGET_FRACTION=0.5

# -- Worker lease (BROKER_ASSIGNMENT_FENCE_MARGIN_MS must stay below the TTL) --
BROKER_ASSIGNMENT_TTL_MS=60000
BROKER_ASSIGNMENT_FENCE_MARGIN_MS=15000
BROKER_CYCLE_ASSIGNMENT_MODE=owner

# -- Risk: at most the platform ceilings (0.40 % of equity per trade, 15 % stop); a profile can only be tighter --
MAX_RISK_PER_TRADE_PCT=0.40
STOP_LOSS_PCT=0.02

# -- Order and billing flags --
# Real-money submission: off in this profile.
LIVE_ORDER_SUBMISSION_ENABLED=false
# Demo submission: off in this profile.
DEMO_ORDER_SUBMISSION_ENABLED=false
# Billing enforcement is the business owner's step (EXT-BILL-01), never a template value.
BILLING_ENFORCED=false

# -- Secrets: none in this file. A developer's own values live in an untracked file outside the checkout. --
