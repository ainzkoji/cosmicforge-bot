# CosmicForge configuration profile: Controlled live beta
#
# A TEMPLATE WITH NO SECRETS. Validate it (and any copy you make) with
#   python scripts/validate_config_profile.py deploy/profiles/live-beta.env.example
# Rules: backends/shared/shared_lib/core/config_profiles.py. Format: plain KEY=value lines (systemd EnvironmentFile
# and compose env_file read the same format); a comment only on its own line.
# Secrets never appear here: they are delivered by file (PROFILE_SECRETS_ENV_FILE, PGPASSFILE). PROFILE_* keys are
# read by the process manager / deployer, not by the application (which ignores unknown keys).
# Purpose: the controlled live beta (Stage A / Stage B, EXT-BETA-A/B). REFUSED by the validator in this build:
# the build is not live-capable (PROFILE_REQUIRES_LIVE_CAPABLE_BUILD). Its structure validates, ready for review.

CONFIG_PROFILE=live_beta

# -- Runtime: the production profile (validated at startup: PRODUCTION_PROFILE_CONFLICT) --
APP_ENV=PRODUCTION
RUNTIME_ENV=PRODUCTION
API_ENV=PRODUCTION
UI_ENV=PRODUCTION
ENVIRONMENT_NAME=production
DATABASE_ROLE=production
EXECUTION_MODE=live
CATI_MODE=LIVE
CATI_SOLE_ENGINE=true
TRADING_ENABLED=true
MARKET_DATA_MODE=LIVE
BROKER_ENVIRONMENT=ACCOUNT_SCOPED
STRATEGY_NAME=RESIDUAL_MOMENTUM_PORTFOLIO_TOP1
BROKER_DISCOVERY_ENABLED=true
BALANCE_SYNC_ENABLED=true
POSITION_SYNC_ENABLED=true
ORDER_SYNC_ENABLED=true
RECONCILIATION_ENABLED=true
RISK_ENGINE_ENABLED=true
FX_PIPELINE_ENABLED=true
FORWARD_OBSERVATION_ENABLED=true
LEGACY_V2_ENABLED=false
FALLBACK_ENGINE_ENABLED=false
PAPER_TRADING_MODE=false
ML_ENABLED=false
TRADINGVIEW_EXTERNAL_SIGNALS_ENABLED=false
TRADINGVIEW_ALLOW_PAPER_LIVE_MODE=false
TRADINGVIEW_TESTNET_ONLY=false
EVENT_FILTER_STALE_FAILSAFE_TESTNET_WARN_ONLY=false
# The trading process (exactly one). API replicas use the same profile with PROCESS_ROLE=api.
PROCESS_ROLE=trading

# -- Databases: PostgreSQL (EXT-DB-01 is the owner's switch); the password comes from PGPASSFILE, never the URL --
DATABASE_URL=postgresql://cosmicforge@postgres:5432/cosmicforge_runtime
PLATFORM_DATABASE_URL=postgresql://cosmicforge@postgres:5432/cosmicforge
PLATFORM_DB_POOL_SIZE=10
PGPASSFILE=/etc/cosmicforge/secrets/pgpass

# -- Exchange environment: canonical LIVE endpoints; each broker account's own environment (DEMO or LIVE) decides --
BINANCE_ENV=mainnet
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BYBIT_ENV=mainnet
BYBIT_BASE_URL=https://api.bybit.com
BINGX_ENV=mainnet
BINGX_BASE_URL=https://open-api.bingx.com

# -- Request budget: the shared admission scope and the universe share of the venue weight. The per-venue weights
# and the user-stream (WebSocket) limits are code constants (shared_lib.broker.rate_budget, user_stream.py). --
CATI_EGRESS_SCOPE=live-beta-egress
UNIVERSE_REQUEST_WEIGHT_BUDGET_FRACTION=0.5

# -- Worker lease (BROKER_ASSIGNMENT_FENCE_MARGIN_MS must stay below the TTL) --
BROKER_ASSIGNMENT_TTL_MS=60000
BROKER_ASSIGNMENT_FENCE_MARGIN_MS=15000
BROKER_CYCLE_ASSIGNMENT_MODE=owner

# -- Risk: at most the platform ceilings (0.40 % of equity per trade, 15 % stop); a profile can only be tighter --
MAX_RISK_PER_TRADE_PCT=0.40
STOP_LOSS_PCT=0.02

# -- Order and billing flags --
# OPERATOR ACT: real-money submission is switched on only by the operator on the host, after every
# go-live condition holds, and only in a live-capable build (section 30). Never true in a template;
# this build refuses it at startup (K4).
LIVE_ORDER_SUBMISSION_ENABLED=false
# Demo submission: off in this profile.
DEMO_ORDER_SUBMISSION_ENABLED=false
# Billing enforcement is the business owner's step (EXT-BILL-01), never a template value.
BILLING_ENFORCED=false

# -- Alerting, backups, revocation anchor (the systemd units' EnvironmentFile paths and the anchor volume) --
PROFILE_ALERTS_ENV_FILE=/etc/cosmicforge/alerts.env
PROFILE_OFFSITE_BACKUP_ENV_FILE=/etc/cosmicforge/offsite-backup.env
PROFILE_BACKUP_TIMERS=cosmicforge-db-backup.timer,cosmicforge-platform-db-backup.timer,cosmicforge-offsite-backup.timer
GOLIVE_REVOCATION_ANCHOR=/var/lib/cosmicforge-anchor/revocations.jsonl

# -- Secrets: delivered by file only (mode 0640 root:cosmicforge, outside any checkout). It holds SECRET_KEY,
# BROKER_SECRET_KEY, CREDENTIAL_KEY, the KYC keys, LEGAL_EVIDENCE_HASH_KEY, TRACK_RECORD_PSEUDONYM_KEY, SMTP and Stripe
# values (EXT-SEC-02). systemd: EnvironmentFile=<this path>; compose: env_file: [<this path>]. --
PROFILE_SECRETS_ENV_FILE=/etc/cosmicforge/secrets/bot-backend.env
