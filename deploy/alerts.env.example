# Where failure alerts are sent. Read by scripts/notify_failure.py, which
# cosmicforge-alert@.service runs whenever a CosmicForge unit fails.
#
# Target file:  /etc/cosmicforge/alerts.env
# Permissions:  sudo install -d -m 0750 -o root -g cosmicforge /etc/cosmicforge
#               sudo install -m 0640 -o root -g cosmicforge deploy/alerts.env.example /etc/cosmicforge/alerts.env
# Test:         sudo -u cosmicforge python3 /opt/cosmicforge/cosmicforge-bot/scripts/notify_failure.py --test
#
# Format: plain KEY=value lines (systemd reads this file too): no spaces
# around "=", no "export", no comment after a value.
# Configure AT LEAST ONE channel; every configured channel receives every
# alert. A channel is used only when all of its variables are set. With none
# set the alert is only written to the journal and nobody is told.
# These are secrets: anyone holding the webhook URL or the bot token can post
# to your channel. Never commit the real file.

# -- 1. Webhook (Slack "incoming webhook", Discord webhook, Mattermost, ...) --
# Receives a JSON POST: {"text": "...", "content": "..."}.
ALERT_WEBHOOK_URL=

# -- 2. Telegram --------------------------------------------------------------
# Create a bot with @BotFather, send it one message from the account or group
# that should be alerted, then read the chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Use a bot dedicated to alerts, not the one that serves users.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# -- 3. Email -----------------------------------------------------------------
# Comma-separated recipients. Uses the same SMTP_* names as the user-backend
# .env (STARTTLS on 587; implicit TLS when SMTP_PORT=465). SMTP_PASS and
# SMTP_FROM are accepted as well.
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
