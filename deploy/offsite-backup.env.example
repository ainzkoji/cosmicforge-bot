# Where the nightly database backup is copied to, and how it is encrypted.
# Read by scripts/offsite_backup.py (cosmicforge-offsite-backup.service).
#
# Target file:  /etc/cosmicforge/offsite-backup.env
# Permissions:  sudo install -m 0640 -o root -g cosmicforge deploy/offsite-backup.env.example /etc/cosmicforge/offsite-backup.env
# Test:         sudo -H -u cosmicforge python3 /opt/cosmicforge/cosmicforge-bot/scripts/offsite_backup.py --dry-run
#
# Format: plain KEY=value lines (systemd reads this file too): no spaces
# around "=", no "export", no comment after a value.
# This file holds no credentials: rclone keeps its own in the service user's
# ~/.config/rclone/rclone.conf (sudo -H -u cosmicforge rclone config), rsync
# uses the service user's SSH key.

# -- Destination: set at least one ---------------------------------------------
# An rclone remote and path, e.g. b2:my-bucket/cosmicforge or s3:bucket/prefix.
# Give the key write access to this one bucket only, and let the bucket's
# lifecycle / object-lock rules decide how long copies are kept: this job never
# deletes anything remote.
BACKUP_RCLONE_REMOTE=
# and/or an rsync target, e.g. backup@backup-host:/srv/cosmicforge-backups
BACKUP_RSYNC_TARGET=

# -- Encryption: set one -------------------------------------------------------
# The database holds broker credentials and identity data. The upload is
# REFUSED while neither recipient is set.
# age (recommended): the PUBLIC key printed by `age-keygen -o key.txt` on a
# machine that is NOT this server ("age1..."), or the path of a recipients
# file. The private key stays off the server: it is needed only to restore.
BACKUP_ENCRYPTION_RECIPIENT=
# gpg: a key id or email whose PUBLIC key is in the service user's keyring
# (sudo -H -u cosmicforge gpg --import backup-public-key.asc).
BACKUP_GPG_RECIPIENT=
# Only for a destination you already encrypt yourself (for example an rclone
# "crypt" remote). Leave it false otherwise.
BACKUP_ALLOW_PLAINTEXT_OFFSITE=false

# -- Optional (defaults shown) --------------------------------------------------
# BACKUP_DIR=/var/backups/cosmicforge
# Fail when the newest verified local backup is older than this.
# BACKUP_MAX_AGE_HOURS=36
