# Staging environment (copy to staging.env OUTSIDE version control; fill the secret placeholders there).
# Values marked <secret> are injected by the operator or a secret manager; never commit them.
# APP_ENV accepts PRODUCTION, TEST or DEVELOPMENT. Staging runs the DEVELOPMENT profile with the production
# topology: the PRODUCTION profile forces mainnet/LIVE endpoints and must never be used for a non-live stack.
# A production-profile staging (demo endpoints, production secret checks) needs a reviewed profile change
# (EXT-STG-01).
APP_ENV=DEVELOPMENT
ENVIRONMENT_NAME=staging
DATABASE_ROLE=staging
# Platform layer (shared by all workers). Password comes from the same secret as the postgres service.
PLATFORM_DATABASE_URL=postgresql://cosmicforge:<secret>@postgres:5432/cosmicforge
PLATFORM_DB_POOL_SIZE=10
# Trading authority stays closed in staging. Do not change these here.
LIVE_ORDER_SUBMISSION_ENABLED=false
DEMO_ORDER_SUBMISSION_ENABLED=false
BILLING_ENFORCED=false
EXECUTION_MODE=paper
# Secrets
SECRET_KEY=<secret>
BROKER_SECRET_KEY=<secret>
CREDENTIAL_KEY=<secret>
STRIPE_SECRET_KEY=<secret: a Stripe TEST-mode key only>
STRIPE_WEBHOOK_SECRET=<secret>
