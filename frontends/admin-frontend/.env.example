# =============================================================================
# CosmicForge Admin Frontend – Environment Variables
# =============================================================================
# Copy this file to .env.local (or .env) for local development.
# Production deployments should set these via the host environment or CI/CD.
# Never commit real secrets to .env.example.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend URLs
# ---------------------------------------------------------------------------

# User Backend – primary API server (port 8000)
# Handles: user auth, trading, broker connections, legacy admin fallback,
#          admin write/action routes, admin auth login/logout/session.
VITE_API_BASE=http://localhost:8000

# Admin Backend – read-only admin visibility server (port 8100)
# Handles: migrated admin read-only route groups (see flags below).
# Set to the deployed Admin Backend URL in production (e.g. https://admin-api.example.com).
VITE_ADMIN_API_BASE=http://localhost:8100

# ---------------------------------------------------------------------------
# Admin Backend Feature Flags – Read-Only Migration
# ---------------------------------------------------------------------------
# Each flag controls which backend serves the corresponding admin read group.
#
#   true  → Admin Backend (port 8100) serves the read requests for this group.
#   false → User Backend  (port 8000) serves the read requests (legacy fallback).
#
# IMPORTANT:
#   - Write/action routes (POST /api/admin/events/seed, POST /api/admin/news/import,
#     POST /api/admin/signals/*/publish, POST /api/admin/users/create, etc.)
#     ALWAYS use port 8000 (VITE_API_BASE), regardless of these flags.
#   - Admin auth login / logout / session (/api/v1/admin-auth/*) ALWAYS uses port 8000.
#   - User frontend is unaffected by these flags (it only uses VITE_API_BASE).
#   - Setting any flag to false immediately falls back to the user-backend
#     without any code changes – safe rollback at any time.
# ---------------------------------------------------------------------------

# Dashboard stats, revenue overview chart, top trading pairs, user list
VITE_USE_ADMIN_BACKEND_DASHBOARD=true

# Revenue analytics overview (subscription + commission totals, plan breakdown)
VITE_USE_ADMIN_BACKEND_REVENUE=true

# TradingView webhook visibility, alert log, signal decisions,
# external signal queue, processor heartbeat status
VITE_USE_ADMIN_BACKEND_TRADINGVIEW=true

# Bot Monitor: bot overview, run list, run detail, live positions and decisions
VITE_USE_ADMIN_BACKEND_BOT_MONITOR=true

# Signal Admin: published signals, candidates, pair universe,
# pair metrics/scoring, scan run history and results
VITE_USE_ADMIN_BACKEND_SIGNALS=true

# Event Calendar: upcoming economic events, active blackout windows,
# feed staleness status, market reactions, event market snapshots
VITE_USE_ADMIN_BACKEND_EVENTS=true

# News Intelligence: feed status, runtime mode, news clusters, narratives,
# intelligence signals, market validations, provider health, influence decisions,
# real-time feed, duplicate/conflict detection, market confirmations
VITE_USE_ADMIN_BACKEND_NEWS=true

# Profitability report: snapshot-backed executed-trade performance,
# symbol profitability, recent windows, and sizing cap evidence
VITE_USE_ADMIN_BACKEND_PROFITABILITY=true

# ML Monitoring: snapshot-backed read-only monitoring endpoints
# (actions still always use VITE_API_BASE / port 8000)
VITE_USE_ADMIN_BACKEND_ML=true

# ---------------------------------------------------------------------------
# NOT YET MIGRATED – these always use VITE_API_BASE (port 8000)
# ---------------------------------------------------------------------------
# User detail               GET /api/admin/users/{user_id}
# Compliance                GET /api/admin/compliance/*
# Audit logs                GET /api/admin/audit-logs
# Settings / Affiliate      GET /api/admin/settings, /affiliate/settings
# Admin auth                POST /api/v1/admin-auth/login|logout|refresh, GET /me
#
# All write/action routes (POST/PUT) always use port 8000:
#   POST /api/admin/events/seed
#   POST /api/admin/events/cleanup-expired
#   POST /api/admin/news/import
#   POST /api/admin/signals/{id}/publish|unpublish|cancel
#   POST /api/admin/signals/pairs/{symbol}/enable|disable|blacklist|whitelist
#   POST /api/admin/signals/pairs/refresh
#   POST /api/admin/users/create, /{id}/suspend, /{id}/activate
#   POST /api/admin/roles/grant, /revoke
#   POST /api/admin/compliance/kyc/{id}/approve, /reject
#   POST /api/admin/ml/actions/{action_key}
#   PUT  /api/admin/settings, /affiliate/settings
# ---------------------------------------------------------------------------
