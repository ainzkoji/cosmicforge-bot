# Database
DATABASE_URL=sqlite:///./bot.db

# Binance API
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_RECV_WINDOW=5000
BINANCE_ENV=mainnet

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_ENV=mainnet
# BYBIT_BASE_URL=https://api-testnet.bybit.com
# BYBIT_ACCOUNT_TYPE=UNIFIED
# BYBIT_CATEGORY_DEFAULT=linear

# BingX (Future)
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_ENV=mainnet

# NOT an access control: no endpoint checks ENGINE_API_KEY / X-ENGINE-KEY, so
# it protects nothing. The user-backend authenticates to this engine with JWTs
# signed with SECRET_KEY (below): the signed-in user's token, or a short-lived
# service token for admin emergency calls. What protects the engine is one
# strong SECRET_KEY shared by all three services, and listening on 127.0.0.1 only.
ENGINE_API_KEY=CHANGE_ME_BEFORE_PRODUCTION

# JWT verification. REQUIRED in production: with APP_ENV=PRODUCTION the engine
# refuses to start while this is missing, a placeholder (like the value below)
# or shorter than 32 characters. Must be the SAME value as the user-backend
# and admin-backend SECRET_KEY, or every user request is rejected.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION

# Trading Configuration
EXECUTION_MODE=live
TRADE_SYMBOLS=BTCUSDT,ETHUSDT
MAX_SYMBOLS=2
DEFAULT_LEVERAGE=3
MIN_LEVERAGE=1
# A-8: Minimum 50 USDT per order. Below this, exchange min-notional checks fail silently.
# Users cannot deploy with less than 50 USDT per position.
TRADE_USDT_PER_ORDER=50
DAILY_MAX_LOSS_USDT=50
MIN_NOTIONAL_USDT=5
# A-1: Default must be 15m or higher for signal generation.
# Never use 1m as the default signal interval — 1m is execution monitoring only.
DEFAULT_INTERVAL=15m
SIGNAL_INTERVAL=15m
HIGHER_TIMEFRAME_INTERVAL=1h
EXECUTION_MONITOR_INTERVAL=1m
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=3.0
TRADE_MODE=normal
# A-9: Default strategy must be master_ensemble. sma_cross rejected in live mode.
STRATEGY_NAME=RESIDUAL_MOMENTUM_PORTFOLIO_TOP1

# Runner Configuration
RUN_INTERVAL_SECONDS=60
RUN_MAX_SYMBOLS=2

# Symbol Leverage Mapping (optional, format: SYMBOL1:LEV1,SYMBOL2:LEV2)
SYMBOL_LEVERAGE_MAP=

# Live Trading Symbols (comma-separated, optional)
LIVE_SYMBOLS=
MAX_LIVE_TRADES_PER_CYCLE=1

# TradingView External Signal Runner
# External signals are CONFIRMATION ONLY.
# They cannot bypass internal filters, risk checks, or override SL/TP.
TRADINGVIEW_EXTERNAL_SIGNALS_ENABLED=false
TRADINGVIEW_TESTNET_ONLY=false
TRADINGVIEW_QUEUE_MAX_PER_CYCLE=1
TRADINGVIEW_ALLOW_PAPER_LIVE_MODE=false
PAPER_TRADING_MODE=false
TRADINGVIEW_LIVE_MODE_PROOF_ENABLED=false
TRADINGVIEW_LIVE_MODE_ACKNOWLEDGED=false
TRADINGVIEW_LIVE_MODE_LIMITED_ENABLED=false
TRADINGVIEW_ALLOWED_ACTIONS=BUY,SELL
TRADINGVIEW_ALLOW_CLOSE=false
TRADINGVIEW_ALLOW_REVERSE=false
TRADINGVIEW_ALLOW_REDUCE=false
TRADINGVIEW_ALLOW_CANCEL=false
TRADINGVIEW_ALLOW_EXTERNAL_SLTP=false
TRADINGVIEW_ALLOW_EXTERNAL_SIZE=false
TRADINGVIEW_ALLOW_RISK_OVERRIDE=false
TRADINGVIEW_MAX_QUEUE_PER_CYCLE=1
TRADINGVIEW_MAX_EXECUTIONS_PER_DAY=3
TRADINGVIEW_MAX_SIGNALS_PER_HOUR=5
TRADINGVIEW_MAX_SIGNALS_PER_DAY=20
TRADINGVIEW_MAX_TRADE_USDT_CAP=150
TRADINGVIEW_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
TRADINGVIEW_REQUIRE_SLTP_PROTECTION=true
TRADINGVIEW_AUTO_DISABLE_ON_INVARIANT_FAIL=true

# Risk Configuration — SAFETY CRITICAL
# MAX_ADDS_PER_POSITION=0 disables ALL position adding (martingale protection).
MAX_ADDS_PER_POSITION=0
# A-6: Max 6 trades per day. Prevents overtrading on 15m signal interval.
MAX_TRADES_DAILY=6
# A-5: Max 3 simultaneous open positions. Limits correlated exposure.
MAX_OPEN_POSITIONS=3
MAX_WEEKLY_DRAWDOWN_PCT=5.0
MAX_MONTHLY_DRAWDOWN_PCT=10.0
MAX_CONSECUTIVE_LOSSES=3
# A-4: true = close ALL open positions when daily kill switch fires.
# Never set false in production — leaving positions open after kill switch allows further losses.
KILL_SWITCH_CLOSE_POSITIONS=true

# A-7: Event/news blackout filter.
# true = block new entries 30 min before and 15 min after high-impact events.
EVENT_FILTER_ENABLED=true
NEWS_TRADING_ENABLED=false
HIGH_IMPACT_BLACKOUT_MINUTES_BEFORE=30
HIGH_IMPACT_BLACKOUT_MINUTES_AFTER=15
# Economic calendar auto-ingestion. Without it the calendar is only what was seeded manually and goes stale
# (EventFilter "Feed stale": warn-only on demo, fail-closed in production). The feed below is public, keyless and
# ForexFactory-compatible; it covers the CURRENT week only, so events after it roll over appear on the next fetch.
EVENT_INGESTION_ENABLED=true
EVENT_MACRO_JSON_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# B-1: Daily close — automatically closes profitable positions at end of session.
# Enabled by default to prevent unintended overnight exposure.
DAILY_CLOSE_ENABLED=true
DAILY_CLOSE_TIMEZONE=Europe/Rome
DAILY_CLOSE_WINDOW_START=23:55
DAILY_CLOSE_WINDOW_END=00:35
DAILY_CLOSE_MIN_PROFIT_USDT=0.0
DAILY_CLOSE_MIN_PROFIT_PCT=0.1

MIN_RISK_REWARD=1.8

# ── Adaptive Entry Threshold Engine ──────────────────────────────────────
# ONE engine, ONE policy, ONE band. AdaptiveEntryThresholdEngine is the only
# entry-threshold authority in the system.
#
# THRESHOLD_BASE is the centre of the adaptive band, not a floor applied
# afterwards. Threshold policy 1.1.0 recalibrated base, band and every
# magnitude to the confidence scale the ensemble produces; derivation in
# docs/adaptive_threshold_recalibration_report.md.
#
# The deleted keys MIN_CONFIDENCE_THRESHOLD and ENSEMBLE_MIN_THRESHOLD_FLOOR
# are now REJECTED at startup. Re-adding either fails configuration validation
# with LEGACY_THRESHOLD_CONFIGURATION_PRESENT.
THRESHOLD_ENGINE_MODE=ADAPTIVE
THRESHOLD_BASE=0.30
THRESHOLD_MIN=0.25
THRESHOLD_MAX=0.60

# ── Section 2 Emergency Safety Profile ──────────────────────────────────────
# FIX-D: 20% of original SL distance used as break-even buffer (wired via runner).
BREAK_EVEN_BUFFER_FRACTION=0.20

# FIX-E: Block STRONG_TREND (24% WR loss driver). RANGE (52.9% WR) is NOT blocked.
# Set ML_ENABLED=False always until Phase I gates are satisfied.
ML_ENABLED=false
ENSEMBLE_BLOCKED_REGIMES=STRONG_TREND

# Session filter: 06:00–19:00 UTC only (best window from expectancy analysis).
ENSEMBLE_SESSION_FILTER_ENABLED=True
ENSEMBLE_SESSION_WINDOWS_UTC=06:00-19:00

# IOFS Gate 0: disabled/shadow by default. Never default to enforce.
IOFS_GATE_ENABLED=False
IOFS_GATE_MODE=shadow
IOFS_RISK_PROFILE=balanced
IOFS_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
IOFS_SESSION_FILTER_ENABLED=True
IOFS_SESSION_WINDOWS_UTC=07:00-10:00,13:00-16:00

# Nightly strict organic dataset refresh. Explicitly enable only in the active
# validation environment; application default remains disabled.
ORGANIC_DATASET_NIGHTLY_ENABLED=False
ORGANIC_DATASET_NIGHTLY_TIME_UTC=02:00
ML_RETRY_WATCHER_ENABLED=True
ML_RETRY_MIN_ORGANIC_ROWS=500
ML_RETRY_MIN_IOFS_ORGANIC_ROWS=300
ML_RETRY_MIN_CLOSED_IOFS_TRADES=20
ORGANIC_DATASET_OUTPUT_PATH=models/datasets/training_v2_organic.parquet
APP_ENV=PRODUCTION
RUNTIME_ENV=PRODUCTION
CATI_MODE=LIVE
CATI_SOLE_ENGINE=true
TRADING_ENABLED=true
MARKET_DATA_MODE=LIVE
BROKER_ENVIRONMENT=ACCOUNT_SCOPED
API_ENV=PRODUCTION
UI_ENV=PRODUCTION
DATABASE_ROLE=production
ENVIRONMENT_NAME=production
LEGACY_V2_ENABLED=false
FALLBACK_ENGINE_ENABLED=false
LIVE_ORDER_SUBMISSION_ENABLED=false
DEMO_ORDER_SUBMISSION_ENABLED=true
BYBIT_BASE_URL=https://api.bybit.com
BINGX_BASE_URL=https://open-api.bingx.com
BROKER_DISCOVERY_ENABLED=true
BALANCE_SYNC_ENABLED=true
POSITION_SYNC_ENABLED=true
ORDER_SYNC_ENABLED=true
RECONCILIATION_ENABLED=true
RISK_ENGINE_ENABLED=true
FX_PIPELINE_ENABLED=true
FORWARD_OBSERVATION_ENABLED=true
EVENT_FILTER_STALE_FAILSAFE_TESTNET_WARN_ONLY=false

# API surface hardening
# Caller-supplied broker gateway / bridge addresses (IBKR host:port, IBKR
# gateway URL, MT4/MT5 bridge URL) are validated before the engine connects.
# In production (APP_ENV=PRODUCTION) loopback and private addresses are refused
# unless listed here: comma-separated host or host:port, e.g. 127.0.0.1:4001.
# Link-local / cloud-metadata addresses can never be allow-listed.
# ADMINS ONLY: a listed address is the platform's own gateway, so only a caller
# with the admin role can target it (test-connection, IBKR connect). Ordinary
# users can only ever reach public addresses in production, listed or not.
# Gateway / bridge URLs must be https in production (plain http is accepted
# only for a listed host) and may not carry a query string or fragment.
BROKER_GATEWAY_ALLOWED_HOSTS=
# auto = verify TLS in production, legacy behaviour elsewhere (self-signed
# local gateways unverified); true = always verify; false = legacy everywhere.
BROKER_GATEWAY_VERIFY_TLS=auto
# /docs, /redoc and /openapi.json are disabled in production unless true.
API_DOCS_ENABLED=false
