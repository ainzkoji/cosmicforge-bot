# Database
DATABASE_URL=sqlite:///./bot.db

# --- Broker / Exchange Configuration ---

# Broker Selection (binance, bybit, etc.)
BROKER_ID=binance_futures

# Binance (Required if BROKER_ID=binance_futures)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENV=mainnet
# BINANCE_FAPI_BASE_URL=https://fapi.binance.com

# Bybit (Required if BROKER_ID=bybit)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_ENV=mainnet
# BYBIT_BASE_URL=https://api.bybit.com
# BYBIT_ACCOUNT_TYPE=UNIFIED
# BYBIT_CATEGORY_DEFAULT=linear

# BingX (Future)
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_ENV=mainnet

# JWT Authentication
# REQUIRED in production: with APP_ENV=PRODUCTION the service refuses to start
# while this is missing, a placeholder (like the value below) or shorter than
# 32 characters. Must be the SAME value in user-backend, bot-backend and
# admin-backend (they verify each other's tokens).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION
# REQUIRED in production (same rules as SECRET_KEY, but a DIFFERENT value).
# Encrypts stored 2FA (TOTP) secrets; changing it later locks out every user
# who has 2FA enabled, so back it up with the database.
CREDENTIAL_KEY=CHANGE_ME_BEFORE_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Engine Service (IMPORTANT: ENGINE_API_KEY must match bot-backend)
ENGINE_URL=http://localhost:9000
ENGINE_API_KEY=CHANGE_ME_BEFORE_PRODUCTION

# CORS
FRONTEND_URL=http://localhost:5173

# KYC & Security
KYC_ENCRYPTION_KEY=your-kyc-encryption-key-32-chars-min
# REQUIRED in production (KYC endpoints answer 503 without real values; the
# placeholder above is refused). Generate each with: openssl rand -hex 32
# KYC_ENCRYPTION_KEY encrypts KYC personal data and identity documents at
# rest: keep it stable and backed up, or stored data becomes unreadable.
# KYC_URL_SECRET signs the short-lived KYC upload URLs.
KYC_URL_SECRET=
# Optional: where encrypted KYC documents are stored (default: data/kyc_uploads
# inside user-backend). Use a private directory outside the repository checkout.
# KYC_UPLOAD_DIR=

# Telegram webhook authentication. REQUIRED in production if the Telegram
# webhook is used: updates without the matching
# X-Telegram-Bot-Api-Secret-Token header are rejected. Use the SAME value as
# `secret_token` when registering the webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d url=https://<api-host>/api/notifications/telegram/webhook -d secret_token=<value>
# (1-256 characters, only A-Z a-z 0-9 _ and -)
TELEGRAM_WEBHOOK_SECRET=

# Billing (Stripe). In production, checkout answers 503 "Billing is not
# configured" until STRIPE_SECRET_KEY, the four price ids and FRONTEND_URL are
# set; there is no mock provider in production. Outside production a missing
# key selects a mock provider that never grants a plan.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). The webhook
# (POST /api/billing/webhook) rejects EVERY request while this is empty.
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (price_...) of the recurring prices, one per plan/interval.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_WHALE_MONTHLY=
STRIPE_PRICE_WHALE_YEARLY=
# Checkout returns to FRONTEND_URL (above) + /payment/success. Set
# PUBLIC_APP_URL only if the public site URL differs from FRONTEND_URL.
# PUBLIC_APP_URL=
# Production refuses Stripe test-mode keys and test-mode webhook events (a test
# card would otherwise buy a real plan). Set to true ONLY for a pre-launch dry run.
# BILLING_ALLOW_STRIPE_TEST_MODE=false

# Email: REQUIRED in production. Email-verification and password-reset codes
# are sent over SMTP (STARTTLS). Without SMTP_HOST and SMTP_USER nobody can
# verify an account or reset a password in production (codes are only written
# to the log when APP_ENV is not PRODUCTION).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cosmicforge.io
# The shared mailer reads SMTP_PASS / SMTP_FROM; this service also accepts
# SMTP_PASSWORD / SMTP_FROM_EMAIL and passes them on.
# SMTP_PASS=
# SMTP_FROM_EMAIL=
APP_ENV=PRODUCTION
RUNTIME_ENV=PRODUCTION
CATI_MODE=LIVE
CATI_SOLE_ENGINE=true
TRADING_ENABLED=true
MARKET_DATA_MODE=LIVE
BROKER_ENVIRONMENT=ACCOUNT_SCOPED
API_ENV=PRODUCTION
UI_ENV=PRODUCTION
DATABASE_ROLE=production
ENVIRONMENT_NAME=production
LEGACY_V2_ENABLED=false
FALLBACK_ENGINE_ENABLED=false
LIVE_ORDER_SUBMISSION_ENABLED=false
DEMO_ORDER_SUBMISSION_ENABLED=true
EXECUTION_MODE=live
STRATEGY_NAME=RESIDUAL_MOMENTUM_PORTFOLIO_TOP1
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BYBIT_BASE_URL=https://api.bybit.com
BINGX_BASE_URL=https://open-api.bingx.com
PAPER_TRADING_MODE=false
ML_ENABLED=false
TRADINGVIEW_TESTNET_ONLY=false
TRADINGVIEW_EXTERNAL_SIGNALS_ENABLED=false
TRADINGVIEW_ALLOW_PAPER_LIVE_MODE=false
BROKER_DISCOVERY_ENABLED=true
BALANCE_SYNC_ENABLED=true
POSITION_SYNC_ENABLED=true
ORDER_SYNC_ENABLED=true
RECONCILIATION_ENABLED=true
RISK_ENGINE_ENABLED=true
FX_PIPELINE_ENABLED=true
FORWARD_OBSERVATION_ENABLED=true
