# Database
DATABASE_URL=sqlite:///./bot.db

# --- Broker / Exchange Configuration ---

# Broker Selection (binance, bybit, etc.)
BROKER_ID=binance_futures

# Binance (Required if BROKER_ID=binance_futures)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENV=mainnet
# BINANCE_FAPI_BASE_URL=https://fapi.binance.com

# Bybit (Required if BROKER_ID=bybit)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_ENV=mainnet
# BYBIT_BASE_URL=https://api.bybit.com
# BYBIT_ACCOUNT_TYPE=UNIFIED
# BYBIT_CATEGORY_DEFAULT=linear

# BingX (Future)
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_ENV=mainnet

# JWT Authentication
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Engine Service (IMPORTANT: ENGINE_API_KEY must match bot-backend)
ENGINE_URL=http://localhost:9000
ENGINE_API_KEY=CHANGE_ME_BEFORE_PRODUCTION

# CORS
FRONTEND_URL=http://localhost:5173

# KYC & Security
KYC_ENCRYPTION_KEY=your-kyc-encryption-key-32-chars-min

# Billing (Optional - if using Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cosmicforge.io
APP_ENV=PRODUCTION
RUNTIME_ENV=PRODUCTION
CATI_MODE=LIVE
CATI_SOLE_ENGINE=true
TRADING_ENABLED=true
MARKET_DATA_MODE=LIVE
BROKER_ENVIRONMENT=ACCOUNT_SCOPED
API_ENV=PRODUCTION
UI_ENV=PRODUCTION
DATABASE_ROLE=production
ENVIRONMENT_NAME=production
LEGACY_V2_ENABLED=false
FALLBACK_ENGINE_ENABLED=false
LIVE_ORDER_SUBMISSION_ENABLED=false
DEMO_ORDER_SUBMISSION_ENABLED=true
EXECUTION_MODE=live
STRATEGY_NAME=RESIDUAL_MOMENTUM_PORTFOLIO_TOP1
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BYBIT_BASE_URL=https://api.bybit.com
BINGX_BASE_URL=https://open-api.bingx.com
PAPER_TRADING_MODE=false
ML_ENABLED=false
TRADINGVIEW_TESTNET_ONLY=false
TRADINGVIEW_EXTERNAL_SIGNALS_ENABLED=false
TRADINGVIEW_ALLOW_PAPER_LIVE_MODE=false
BROKER_DISCOVERY_ENABLED=true
BALANCE_SYNC_ENABLED=true
POSITION_SYNC_ENABLED=true
ORDER_SYNC_ENABLED=true
RECONCILIATION_ENABLED=true
RISK_ENGINE_ENABLED=true
FX_PIPELINE_ENABLED=true
FORWARD_OBSERVATION_ENABLED=true
